# Server-only Google Places API (New) key.
# Enable "Places API (New)" in Google Cloud, then set this in Vercel / .env.local.
# When unset, the top bar uses the static hours fallback in lib/site-data.ts.
GOOGLE_PLACES_API_KEY=

# Contact form (Resend). Install Resend from the Vercel Marketplace to provision
# RESEND_API_KEY automatically, or paste a key from https://resend.com/api-keys.
# Messages are delivered to CONTACT_TO_EMAIL (defaults to service@edsheavymobile.com).
RESEND_API_KEY=
CONTACT_TO_EMAIL=service@edsheavymobile.com
# Use a verified domain address in production, e.g.:
# CONTACT_FROM_EMAIL=Ed's Heavy Mobile Repair <service@edsheavymobile.com>
CONTACT_FROM_EMAIL=
